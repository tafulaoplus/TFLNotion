rules_version = '2';

// ============================================
// Firestore Security Rules for TFL+ Workspace
// ============================================
// คัดลอกเนื้อหานี้ไปวางใน Firebase Console:
// Firestore Database → Rules → Publish
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Workspace data - เปิดให้อ่าน/เขียนได้สำหรับทีม
    // ความปลอดภัยมาจาก:
    // 1. URL ของ Vercel ที่ไม่ได้แชร์ออกไป
    // 2. PIN 6 หลักของแต่ละ user
    // 3. Workspace ID ใน FIREBASE_WORKSPACE (เปลี่ยนเป็น unique)
    match /workspaces/{workspaceId} {
      allow read, write: if true;
    }

    // ปฏิเสธทุกอย่างอื่น (default deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
